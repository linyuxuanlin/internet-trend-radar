{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "internet-trend-radar",
  "main": "src/index.js",
  "compatibility_date": "2026-08-20",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "migrations_dir": "migrations"
    }
  ],
  "ai": { "binding": "AI" },
  "triggers": {
    "crons": ["*/30 * * * *", "5 0 * * *"]
  },
  "vars": {
    "DAILYHOT_BASE": "https://api-hot.imsyy.top",
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "AI_FALLBACK_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast",
    "AI_DISABLE_FALLBACK": "1",
    "AI_TOP_N": "10",
    "AI_RETRY_MINUTES": "30",
    "AI_REFRESH_HOURS": "6",
    "SITE_NAME": "Trend Radar",
    "PUBLIC_BASE_URL": "",
    "COLLECTOR_SOURCES": "weibo,zhihu,bilibili,baidu,douyin,toutiao,36kr,juejin,hupu,v2ex"
  }
}
