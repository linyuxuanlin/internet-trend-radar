{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "internet-trend-radar",
  "main": "src/index.js",
  "compatibility_date": "2026-08-20",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "trend-radar",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "ai": { "binding": "AI" },
  "triggers": {
    "crons": ["*/30 * * * *", "5 0 * * *"]
  },
  "vars": {
    "DAILYHOT_BASE": "https://api-hot.imsyy.top",
    "AI_MODEL": "@cf/zai-org/glm-4.7-flash",
    "SITE_NAME": "Trend Radar",
    "PUBLIC_BASE_URL": "",
    "COLLECTOR_SOURCES": "weibo,zhihu,bilibili,baidu,douyin,toutiao,36kr,juejin,hupu,v2ex",
    "AI_TOP_N": "8"
  }
}
